  "authors": [
    "Antarip Nandi"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/fast-leaf-decay",
    "sources": "https://github.com/antaripnandi/fast-leaf-decay",
    "issues": "https://github.com/antaripnandi/fast-leaf-decay/issues"
  },
  "license": "MIT",
  "icon": "assets/fastleafdecay/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.antarip.fastleafdecay.FastLeafDecayMod"
    ]
  },
  "mixins": [
    "fastleafdecay.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.15.0",
    "minecraft": "${minecraft_version}"
  }
}
